# Optional: base URL used by server components/metadata when deployed
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Gemini AI (https://ai.google.dev/, free API key from Google AI
# Studio) — used across several features: app/api/ai/process/route.js
# (the Utility Tools Suite's AI Document Summarizer at
# /tools/document-summarizer), and lib/newsAggregator.js /
# lib/sentimentEngine.js's AI-generated headline summaries and macro
# sentiment themes. Tried first; ANTHROPIC_API_KEY (below) is used as
# a fallback by those last two features specifically.
#
# Without this key, the Document Summarizer tool shows a clean "AI
# summarization isn't configured yet" notice instead of breaking —
# every other tool in /tools/* is 100% client-side and has zero
# dependency on this key either way.
GEMINI_API_KEY=

# Anthropic API (https://console.anthropic.com/) — secondary fallback
# for lib/newsAggregator.js / lib/sentimentEngine.js only, used when
# GEMINI_API_KEY is unset or a Gemini call fails. Not currently used
# by app/api/ai/process/route.js.
ANTHROPIC_API_KEY=

# --- app/api/rates/route.js — unified Fiat + Crypto + Metals rates ---
# All three are optional. Each one that's missing falls back to a free
# public endpoint (fiat, crypto) or a static approximate value (metals
# has no keyless public endpoint), so the app always renders — see the
# comments in app/api/rates/route.js for exactly how each fallback works.

# ExchangeRate-API (https://www.exchangerate-api.com/) — fiat currencies.
# Without a key, falls back to the free open.er-api.com endpoint.
EXCHANGE_RATE_API_KEY=
# Older name, still read as a fallback if the one above isn't set:
# EXCHANGERATE_API_KEY=

# CoinGecko (https://www.coingecko.com/en/api) — crypto prices (BTC, ETH,
# SOL, etc). Use a free "Demo" key from the CoinGecko developer dashboard.
# Without a key, requests still go through anonymously at a lower rate
# limit, which is fine at this traffic level.
COINGECKO_API_KEY=

# metals-api.com (https://metals-api.com/) — precious metals (XAU, XAG,
# XPT, XPD). Without a key, or if the key fails (wrong plan, restricted
# base currency, bad/expired key, quota spent), the route automatically
# falls back to api.gold-api.com — a free, keyless provider — so you
# still get LIVE metal prices either way. Only if both are unreachable
# does it drop to static fallback numbers. Check the `metalsDebug` field
# in the /api/rates response (or Vercel function logs) to see the exact
# reason metals-api.com was skipped, if it was.
METALS_API_KEY=

# EIA Open Data API (https://www.eia.gov/opendata/, free signup) — crude
# oil (WTI) daily spot settle. Without a key, or if the call fails, the
# route automatically falls back to Yahoo Finance's free keyless chart
# endpoint (intraday CL=F futures) — so you still get a LIVE price either
# way. Only if both are unreachable does it drop to a static reference
# value. Check the `commodityDebug` field in the /api/rates response (or
# Vercel function logs) to see the exact reason the EIA API was skipped,
# if it was.
EIA_API_KEY=

# FRED — Federal Reserve Economic Data (https://fred.stlouisfed.org/docs/api/api_key.html,
# free signup) — real GDP, CPI, PPI, unemployment and non-farm payrolls
# figures for the Economic Data Heatmap. Without a key, every heatmap row
# stays illustrative (seeded-random, clearly labeled). Even with a key,
# the two PMI rows (Manufacturing/Services) always stay illustrative —
# ISM doesn't publish PMI data through FRED or any other free API.
FRED_API_KEY=

# --- lib/candleData.js / app/api/market-ai/route.js — real intraday
# OHLC candles for RSI/EMA/SMA/Fibonacci on the AI Technical Analysis
# tool (/market-analysis). Both optional — without either key, those
# sections stay exactly as they were before (explicitly labeled
# unavailable/illustrative — see lib/technicalAnalysis.js's header).

# Twelve Data (https://twelvedata.com/, free signup — no credit card) —
# primary provider, covers FX, crypto, metals and WTI under one BASE/USD
# symbol notation. Free tier is ~800 requests/day; lib/candleData.js
# caches each symbol for 15 minutes AND enforces its own conservative
# in-memory daily cap well under that limit, so this can never be the
# thing that exhausts your quota.
TWELVE_DATA_API_KEY=

# Alpha Vantage (https://www.alphavantage.co/support/#api-key, free
# signup) — fallback used only when Twelve Data is unset or fails for a
# given instrument. Free tier is much smaller (~25 requests/day), so
# this is capped even more conservatively — expect it to cover FX and
# crypto only; metals/commodities have no free Alpha Vantage OHLC
# endpoint and stay on the illustrative path regardless of this key.
ALPHA_VANTAGE_API_KEY=

# --- lib/supabase.js — cloud database + auth for the Trading Journal
# (hooks/useTradingJournal.js) and Community Forum
# (hooks/useCommunityPosts.js) cloud sync. Both optional together —
# without them, both features work exactly as before: localStorage-only,
# single-browser, no sign-in. See SUPABASE_SETUP.md for the full setup
# (creating a free Supabase project, the two SQL tables, and the
# required Row Level Security policies) — these two values alone are
# NOT enough; the tables/policies in that file are required too.

# Supabase project URL (Project Settings → API → Project URL).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key (Project Settings → API → anon public).
# Safe to expose to the browser (NEXT_PUBLIC_ prefix is intentional) —
# it only grants whatever Row Level Security policies allow, which is
# why SUPABASE_SETUP.md's policies matter as much as this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- components/AdSense.jsx / components/AdSlot.jsx — Google AdSense ---
# Optional. Without it, AdSense's script never loads and every
# AdSlot on the site renders its unobtrusive placeholder instead of a
# real ad — the site stays fully functional either way. Once the
# AdSense account is approved, set this to the account's publisher ID
# (e.g. "ca-pub-XXXXXXXXXXXXXXXX", from the AdSense dashboard) and fill
# in the matching line in public/ads.txt.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
